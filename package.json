{
  "name": "expo-gbk-converter",
  "version": "2.0.0",
  "description": "An Expo module to decode GBK/GB18030 encoded text from base64 string",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "lint": "eslint src index.ts",
    "test": "node --test tests/*.test.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run build && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evansuner/expo-gbk-converter.git"
  },
  "bugs": {
    "url": "https://github.com/evansuner/expo-gbk-converter/issues"
  },
  "homepage": "https://github.com/evansuner/expo-gbk-converter#readme",
  "keywords": [
    "expo",
    "expo-module",
    "gbk",
    "gb18030",
    "encoding",
    "decoder",
    "chinese",
    "react-native"
  ],
  "author": "Evan Sun <zhidong.s@outlook.com>",
  "license": "MIT",
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {},
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.12",
    "expo-modules-core": "^58.0.20",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "build",
    "src",
    "android",
    "ios",
    "expo-module.config.json"
  ]
}
